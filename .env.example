# Copy to .env and fill locally. Never commit real values.
# The live Nansen integration test skips unless this is set.
NANSEN_API_KEY=

# Optional: allow POST /v1/proof/verify with {"demo": true} (synthetic evidence, no live call).
SINGULANT_PROOF_ALLOW_DEMO=1

# API bind (uvicorn)
HOST=127.0.0.1
PORT=8000
